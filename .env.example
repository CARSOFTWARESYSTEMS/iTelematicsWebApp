# --- Contact form delivery (required for enquiries to be sent) ---
# Enquiries from /api/contact are emailed through Resend (https://resend.com).
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the form shows a clear
# "Not sent" state and points visitors to info@iTelematics.com; it never
# pretends to succeed.
#
# 1. Create a Resend API key with "Sending access".
# 2. Verify the sending domain (e.g. itelematics.com) in Resend (DNS records).
# 3. Set the variables below in the hosting environment (server-side only).
RESEND_API_KEY=
# Must use the verified domain, e.g. "iTelematics Website <website@itelematics.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered. Defaults to info@iTelematics.com when unset.
# CONTACT_TO_EMAIL=info@iTelematics.com

# --- Analytics (see docs/analytics/ANALYTICS.md) ---
# GA4 measurement ID. Unset uses the existing iTelematics property; set to an
# empty value to disable analytics entirely.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8JBWVSV5GE
# Comma-separated hostnames where analytics may load (production builds only).
# NEXT_PUBLIC_ANALYTICS_HOSTS=itelematics.com,www.itelematics.com,ev.engineer,www.ev.engineer
# Log events to the browser console instead of sending them. Local use only.
# NEXT_PUBLIC_ANALYTICS_DEBUG=true
