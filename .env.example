# --- Analytics (see docs/analytics/ANALYTICS.md) ---
# GA4 measurement ID. Unset uses the existing iTelematics property; set to an
# empty value to disable analytics entirely.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8JBWVSV5GE
# Comma-separated hostnames where analytics may load (production builds only).
# NEXT_PUBLIC_ANALYTICS_HOSTS=itelematics.com,www.itelematics.com,ev.engineer,www.ev.engineer
# Log events to the browser console instead of sending them. Local use only.
# NEXT_PUBLIC_ANALYTICS_DEBUG=true
